# Maintainer: SecuryBlack <security@securyblack.com>
pkgname=oxipulse-bin
pkgver=0.4.6
pkgrel=1
pkgdesc='Lightweight host metrics agent that speaks OpenTelemetry (OTLP)'
arch=('x86_64' 'aarch64')
url='https://oxipulse.dev'
license=('Apache-2.0')
depends=('glibc')
options=('!debug' '!strip')
provides=('oxipulse')
conflicts=('oxipulse')
install=oxipulse-bin.install
backup=('etc/oxipulse/config.toml')
_src="https://github.com/securyblack/oxi-pulse"
source=("oxipulse.service::$_src/raw/v$pkgver/packaging/oxipulse.service"
        "config.toml::$_src/raw/v$pkgver/packaging/config.toml")
source_x86_64=("oxipulse-$pkgver-x86_64.tar.gz::$_src/releases/download/v$pkgver/oxipulse-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("oxipulse-$pkgver-aarch64.tar.gz::$_src/releases/download/v$pkgver/oxipulse-aarch64-unknown-linux-gnu.tar.gz")
sha256sums=('3abbace9e94923207074584825da243e23dacb3b2c7deaa9d7a1a78178fb81ae'
            '6b9ecb82362d2c07041147207d67e5ce35d7584742673165fcee0e414c5674b9')
sha256sums_x86_64=('8d0c1e9c19edbe1cfaf03b2d2228e6d04ef0a0e0b7a5c735cfe2a34b5633c486')
sha256sums_aarch64=('27da0f2c81dccd926cf0db7ece8b16f19bafdcf9df2a395a5f06a90e0fbe75fe')

package() {
  install -Dm755 oxipulse "$pkgdir/usr/bin/oxipulse"
  install -Dm644 oxipulse.service "$pkgdir/usr/lib/systemd/system/oxipulse.service"
  install -Dm600 config.toml "$pkgdir/etc/oxipulse/config.toml"
}
